import optuna
from sklearn.model_selection import cross_val_score, GroupKFold

def objective(trial):
    params = {
      'verbosity':0, 'objective':'reg:squarederror',
      'n_estimators': trial.suggest_int('n_estimators', 50, 500),
      'max_depth': trial.suggest_int('max_depth', 3, 12),
      'learning_rate': trial.suggest_float('learning_rate', 0.01, 0.3, log=True),
      'subsample': trial.suggest_float('subsample', 0.6, 1.0),
      'colsample_bytree': trial.suggest_float('colsample_bytree', 0.5, 1.0),
      'reg_alpha': trial.suggest_float('reg_alpha', 0.0, 10.0),
      'reg_lambda': trial.suggest_float('reg_lambda', 0.0, 10.0),
    }
    model = xgb.XGBRegressor(**params, random_state=42, n_jobs=-1)
    params = {
      'verbosity':0, 'objective':'reg:squarederror',
      'n_estimators': trial.suggest_int('n_estimators', 50, 500),
      'max_depth': trial.suggest_int('max_depth', 3, 12),
      'learning_rate': trial.suggest_float('learning_rate', 0.01, 0.3, log=True),
      'subsample': trial.suggest_float('subsample', 0.6, 1.0),
      'colsample_bytree': trial.suggest_float('colsample_bytree', 0.5, 1.0),
      'reg_alpha': trial.suggest_float('reg_alpha', 0.0, 10.0),
      'reg_lambda': trial.suggest_float('reg_lambda', 0.0, 10.0),
    }
    model = xgb.XGBRegressor(**params, random_state=42, n_jobs=-1)

    # choose splitter robustly: use GroupKFold when enough groups, otherwise fallback to KFold
    n_groups = train_df[ID_COL].nunique()
    scores = []

    if n_groups >= 2:
        n_splits = min(5, n_groups)
        gkf = GroupKFold(n_splits=n_splits)
        splitter = gkf.split(X_train, y_train, groups=train_df[ID_COL])
    else:
        from sklearn.model_selection import KFold
        n_splits = min(5, len(X_train))
        n_splits = max(2, n_splits)  # ensure at least 2 splits
        kf = KFold(n_splits=n_splits, shuffle=True, random_state=42)
        splitter = kf.split(X_train, y_train)

    for train_idx, val_idx in splitter:
        model.fit(X_train.iloc[train_idx], y_train.iloc[train_idx],
                  eval_set=[(X_train.iloc[val_idx], y_train.iloc[val_idx])],
                  early_stopping_rounds=30, verbose=False)
        preds = model.predict(X_train.iloc[val_idx])
        scores.append(mean_absolute_error(y_train.iloc[val_idx], preds))

    if len(scores) == 0:
        return 1e6
    return float(np.mean(scores))

study = optuna.create_study(direction='minimize')
study.optimize(objective, n_trials=40)
print(study.best_params)
# for each battery, compute cycle index where SOH <= EOL and derive RUL for earlier cycles
eol_threshold = 70.0
df['rul_cycles'] = np.nan
for bid, g in df.groupby(ID_COL):
    g = g.sort_values(CYCLE_COL).reset_index()
    # find first cycle index where soh <= EOL
    below = g[g['soh_percent'] <= eol_threshold]
    if below.empty:
        # if not reached EOL, set RUL to remaining to last cycle or NaN
        cycle_eol = g[CYCLE_COL].max() + 1000  # or mark NaN
    else:
        cycle_eol = below[CYCLE_COL].iloc[0]
    g['rul_cycles'] = cycle_eol - g[CYCLE_COL]
    df.loc[g['index'], 'rul_cycles'] = g['rul_cycles']
