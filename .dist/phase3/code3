def time_split(df, id_col=ID_COL, cycle_col=CYCLE_COL, test_frac=0.2):
    train_idx, test_idx = [], []
    for bid, g in df.groupby(id_col):
        g_sorted = g.sort_values(by=cycle_col)
        n = len(g_sorted)
        cut = int(n*(1-test_frac))
        train_idx += g_sorted.index[:cut].tolist()
        test_idx  += g_sorted.index[cut:].tolist()
    return df.loc[train_idx], df.loc[test_idx]

